POSTGRES_DB=unireserve
POSTGRES_USER=unireserve
POSTGRES_PASSWORD=unireserve
DATABASE_URL=postgresql://unireserve:unireserve@localhost:5432/unireserve
JWT_ALGORITHM=RS256
# Generate an RSA keypair for JWT signing; do not commit real keys.
JWT_PRIVATE_KEY_PATH=./backend/keys/private.pem
JWT_PUBLIC_KEY_PATH=./backend/keys/public.pem
